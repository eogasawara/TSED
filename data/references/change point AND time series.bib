@CONFERENCE{Akila2023,
	author = {Akila, V. and Nitin, M.V.S. and Prasanth, I. and Reddy M, Sandeep and Akash Kumar, G.},
	title = {A Cryptocurrency Price Prediction Model using Deep Learning},
	year = {2023},
