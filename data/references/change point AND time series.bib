@ARTICLE{Yao2019362,
	author = {Yao, Yuan and Xiao, Bin and Wu, Gaofei and Liu, Xue and Yu, Zhiwen and Zhang, Kailong and Zhou, Xingshe},
	title = {Multi-Channel Based Sybil Attack Detection in Vehicular Ad Hoc Networks Using RSSI},
	year = {2019},
	journal = {IEEE Transactions on Mobile Computing},
	volume = {18},
