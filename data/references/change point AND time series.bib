}

@ARTICLE{Borzykh202019,
	author = {Borzykh, D.A. and Yazykov, A.A.},
	title = {On the practical applicability of three CUSUM-methods for structural breaks detection in EGARCH-models},
	year = {2020},
	journal = {Vestnik Sankt-Peterburgskogo Universiteta, Prikladnaya Matematika, Informatika, Protsessy Upravleniya},
