}@CONFERENCE{Chen202233,
	author = {Chen, Jie and Hu, Haiyang and Yu, Dongjin},
	title = {Characterizing and Triaging Change Points},
	year = {2022},
	journal = {ICPE 2022 - Companion of the 2022 ACM/SPEC International Conference on Performance Engineering},
	pages = {33 – 37},
	doi = {10.1145/3491204.3527487},
