	author = {Yang, Mao and Zhang, Shutian and Wang, Tianshuo and Yang, Shuo and Zhao, Hui},
	title = {Identification Algorithm of Wind Farm Abnormal Data Based on IKLIEP-quartile Model; [基于 IKLIEP−四分位模型的风电场异常数据识别算法]},
	year = {2023},
	journal = {Gaodianya Jishu/High Voltage Engineering},
