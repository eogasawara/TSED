@ARTICLE{Čampulová2018,
	author = {Čampulová, Martina and Michálek, Jaroslav and Mikuška, Pavel and Bokal, Drago},
	title = {Nonparametric algorithm for identification of outliers in environmental data},
	year = {2018},
