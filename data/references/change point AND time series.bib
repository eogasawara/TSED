@ARTICLE{Li2023,
	author = {Li, Rongrong and Xu, Guoce},
	title = {Assessing the impacts of reservoirs on downstream hydrological frequency based on a general rainfall-reservoir index},
	year = {2023},
	journal = {Frontiers in Earth Science},
	volume = {11},
	doi = {10.3389/feart.2023.1204640},
