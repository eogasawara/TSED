}@ARTICLE{Wang2022997,
	author = {Wang, Xiaodong and Hsieh, Fushing},
	title = {Unraveling S&P500 stock volatility and networks–an encoding-and-decoding approach},
	year = {2022},
	journal = {Quantitative Finance},
	volume = {22},
	number = {5},
	pages = {997 – 1016},
