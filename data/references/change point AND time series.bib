@ARTICLE{Cunningham2022,
	author = {Cunningham, Calum X. and Aandahl, Zach and Jones, Menna E. and Hamer, Rowena and Johnson, Christopher N.},
	title = {Regional patterns of continuing decline of the eastern quoll},
