@ARTICLE{Authier2012281,
	author = {Authier, Matthieu and Martin, Céline and Ponchon, Aurore and Steelandt, Stephanie and Bentaleb, Ilham and Guinet, Christophe},
	title = {Breaking the sticks: A hierarchical change-point model for estimating ontogenetic shifts with stable isotope data},
	year = {2012},
	journal = {Methods in Ecology and Evolution},
	volume = {3},
	number = {2},
	pages = {281 – 290},
	doi = {10.1111/j.2041-210X.2011.00162.x},
