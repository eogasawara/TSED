@ARTICLE{Xiong2020,
	author = {Xiong, Manling and Huang, Ching-Sheng and Yang, Tao},
	title = {Assessing the impacts of climate change and land use/cover change on runoff based on improved Budyko framework models considering arbitrary partition of the impacts},
	year = {2020},
	journal = {Water (Switzerland)},
	volume = {12},
	number = {6},
