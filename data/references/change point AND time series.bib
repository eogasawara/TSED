@ARTICLE{Rooch2019313,
	author = {Rooch, Aeneas and Zelo, Ieva and Fried, Roland},
	title = {Estimation methods for the LRD parameter under a change in the mean},
	year = {2019},
	journal = {Statistical Papers},
	volume = {60},
