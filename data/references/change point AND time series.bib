@ARTICLE{Khan2019,
	author = {Khan, Muhammad Rizwan and Sarkar, Biswajit},
	title = {Change point detection for airborne particulate matter (PM2.5, PM10) by using the Bayesian approach},
	year = {2019},
	journal = {Mathematics},
	volume = {7},
