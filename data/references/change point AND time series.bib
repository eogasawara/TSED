@BOOK{Sajjad202273,
	author = {Sajjad, Nilufer and Mishra, Arun Pratap and Pande, Chaitanya Baliram and Tolche, Abebe Debele},
	title = {Spatiotemporal analysis of rainfall trends in semi-arid regions of India over the last 36 years},
	year = {2022},
	journal = {Climate Change Impact on Groundwater Resources: Human Health Risk Assessment in Arid and Semi-Arid Regions},
	pages = {73 – 91},
	doi = {10.1007/978-3-031-04707-7_5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85153998196&doi=10.1007%2f978-3-031-04707-7_5&partnerID=40&md5=67d64135c08d91435814011800c4ae52},
	abstract = {A quantitative and qualitative understanding of the anticipated, climate change-driven, multiscale spatiotemporal shifts in precipitation and attendant river flows is crucial to the development of water resource management approaches, which are capable of sustaining and even improving the ecological and socioeconomic viability of rainfed agricultural regions. A set of homogeneity tests for change point detection, non-parametric trend tests, and Sen's slope estimator were applied to the long-term gridded rainfall records of 26 districts in the state of Maharashtra, India. This study focuses on a key element of climate, i.e. rainfall. Accurately predicting rainfall or precipitation trends is vital for the economic growth and development of a country. The research studied the precipitation variability across the state of Maharashtra using Climate Hazards Group InfraRed Precipitation with Station data (CHIRPS) over a period of 36 years (1982-2018). The data were processed to find seasonal and annual trends using non-parametric analysis. The Mann-Kendall (MK) test was used for the analysis of increasing and decreasing (monotonic) trends together with the non-parametric Sen's slope estimator to estimate the magnitude of trends over time series data. The statistical analysis of the whole reference time series data highlights that (1) the trends look predominantly positive (increasing), both at the annual and seasonal scales, except for the pre-monsoon season (PMS) and (2) the pre-monsoon season (PMS) showed a negative trend for few districts. A total of 26 districts consisting of 130 sub-districts covering 148086.45 km2 of area or 48.1% of the area of Maharashtra showed a positive trend when the p-value was >0.05. In the pre-monsoon season, 8 sub-districts showed a negative trend, whereas 21 districts showed positive trends. © The Author(s), 2022. All rights reserved.},
