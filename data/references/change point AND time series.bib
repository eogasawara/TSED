@ARTICLE{El Sibai201825,
	author = {El Sibai, Rayane and Chabchoub, Yousra and Chiky, Raja and Demerjian, Jacques and Barbar, Kablan},
	title = {An in-depth analysis of CUSUM algorithm for the detection of mean and variability deviation in time series},
	year = {2018},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {10819 LNCS},
