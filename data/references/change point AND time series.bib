}

@ARTICLE{Sels20223133,
	author = {Sels, Laura and Schat, Evelien and Verhofstadt, Lesley and Ceulemans, Eva},
	title = {Introducing change point detection analysis in relationship research: An investigation of couples’ emotion dynamics},
	year = {2022},
	journal = {Journal of Social and Personal Relationships},
	volume = {39},
	number = {10},
	pages = {3133 – 3154},
