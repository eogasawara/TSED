@ARTICLE{Tadesse2022,
	author = {Tadesse, Michael Getachew and Wahl, Thomas and Rashid, Md Mamunur and Dangendorf, Sönke and Rodríguez-Enríquez, Alejandra and Talke, Stefan Andreas},
	title = {Long-term trends in storm surge climate derived from an ensemble of global surge reconstructions},
	year = {2022},
	journal = {Scientific Reports},
