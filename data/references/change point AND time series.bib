	title = {Change-point analysis of v P/V S ratio time-series using a trans-dimensional McMC algorithm: Applied to the Alto Tiberina Near Fault Observatory seismic network (Northern Apennines, Italy)},
	year = {2019},
	journal = {Geophysical Journal International},
	volume = {217},
