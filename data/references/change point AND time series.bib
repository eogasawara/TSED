@ARTICLE{López2017122,
	author = {López, I. and Rodríguez, C. and Gámez, M. and Varga, Z. and Garay, J.},
	title = {Change-point method applied to the detection of temporal variations in seafloor bacterial mat coverage},
	year = {2017},
	journal = {Journal of Environmental Informatics},
