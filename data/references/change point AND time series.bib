	title = {Non-parametric decoding on discrete time series and its applications in bioinformatics},
	year = {2010},
	journal = {Statistics in Biosciences},
	volume = {2},
	number = {1},
	pages = {18 – 40},
	doi = {10.1007/s12561-010-9019-9},
