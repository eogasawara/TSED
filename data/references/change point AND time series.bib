}

@ARTICLE{Vinokur2021205,
	author = {Vinokur, Igor and Tolpin, David},
	title = {Warped Input Gaussian Processes for Time Series Forecasting},
	year = {2021},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {12716 LNCS},
	pages = {205 – 220},
	doi = {10.1007/978-3-030-78086-9_16},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112013990&doi=10.1007%2f978-3-030-78086-9_16&partnerID=40&md5=4a3e151d42bd8a70d5e687203be5f23b},
	abstract = {Time series forecasting plays a vital role in system monitoring and novelty detection. However, commonly used forecasting methods are not suited for handling non-stationarity, while existing methods for forecasting in non-stationary time series are often complex to implement and involve expensive computations. We introduce a Gaussian process-based model for handling of non-stationarity. The warping is achieved non-parametrically, through imposing a prior on the relative change of distance between subsequent observation inputs. The model allows the use of general gradient optimization algorithms for training and incurs only a small computational overhead on training and prediction. The model finds its applications in forecasting in non-stationary time series with either gradually varying volatility, presence of change points, or a combination thereof. We implement the model in a probabilistic programming framework, evaluate on synthetic and real-world time series data comparing against both broadly used baselines and known state-of-the-art approaches and show that the model exhibits state-of-the-art forecasting performance at a lower implementation and computation cost, enabling efficient applications in diverse fields of system monitoring and novelty detection. © 2021, Springer Nature Switzerland AG.},
	author_keywords = {Gaussian processes; Non-stationarity; Probabilistic programming; Time series},
	keywords = {Computer systems programming; Cryptography; Gaussian distribution; Gaussian noise (electronic); Machine learning; Monitoring; Predictive analytics; Security of data; Time series; Time series analysis; Computational overheads; Forecasting performance; Implementation and computation; Non-stationary time series; Probabilistic programming; Real-world time series; State-of-the-art approach; Time series forecasting; Forecasting},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Green Open Access}
}

