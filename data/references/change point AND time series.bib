@ARTICLE{Teegavarapu2021,
	author = {Teegavarapu, Ramesh S. V. and Sharma, Priyank J.},
	title = {Nonoverlapping Block Stratified Random Sampling Approach for Assessment of Stationarity},
	year = {2021},
	journal = {Journal of Hydrologic Engineering},
