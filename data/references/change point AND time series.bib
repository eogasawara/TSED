	abstract = {Volatility is a measure of uncertainty or risk embedded within a stock's dynamics. Such risk has been received huge amounts of attention from diverse financial researchers. By following the concept of regime-switching model, we proposed a non-parametric approach, named encoding-and-decoding, to discover multiple volatility states embedded within a discrete time series of stock returns. The encoding is performed across the entire span of temporal time points for relatively extreme events with respect to a chosen quantile-based threshold. As such the return time series is transformed into Bernoulli-variable processes. In the decoding phase, we computationally seek for locations of change points via estimations based on a new searching algorithm in conjunction with the information criterion applied on the observed collection of recurrence times upon the binary process. Besides the independence required for building the Geometric distributional likelihood function, the proposed approach can functionally partition the entire return time series into a collection of homogeneous segments without any assumptions of dynamic structure and underlying distributions. In the numerical experiments, our approach is found favorably compared with parametric models like Hidden Markov Model. In the real data applications, we introduce the application of our approach in forecasting stock returns. Finally, volatility dynamic of every single stock of S&P500 is revealed, and a stock network is consequently established to represent dependency relations derived through concurrent volatility states among S&P500. © 2022 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {Hidden Markov model; Non-parametric; Stock networks; Volatility analysis},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access, Green Open Access}
}

@ARTICLE{Farooq2021575,
	author = {Farooq, Ishfaq and Shah, Abdul Rauf and Salik, Kashif Majeed and Ismail, Mujtaba},
	title = {Annual, Seasonal and Monthly Trend Analysis of Temperature in Kazakhstan During 1970–2017 Using Non-parametric Statistical Methods and GIS Technologies},
	year = {2021},
	journal = {Earth Systems and Environment},
	volume = {5},
	number = {3},
	pages = {575 – 595},
	doi = {10.1007/s41748-021-00244-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85109256193&doi=10.1007%2fs41748-021-00244-3&partnerID=40&md5=b35de3ea8ca0f09937a49fc1b3516fe2},
	abstract = {Climate change is one of the most challenging environmental issues faced by the present day world community. Its impacts are reflected in different components of the socioeconomic and biophysical systems. Temperature is a fundamental climatic variable that is studied thoroughly across globe for the similar purpose of capturing the dynamic nature of the variable and relating it with the human interventions over time. The main objective of the present study is to analyse the long-term trends in temperature that have occurred in the territory of Kazakhstan on annual, seasonal and monthly time scales. The study used the non-parametric statistical methods such as M–K statistical test, Sen’s slope estimator, and Pettit’s test to analyse the time series data and portray it through various GIS techniques. The results revealed that Kazakhstan showed a significant increasing trend in the mean annual temperature from 1970 to 2017. The Sen’s slope estimator reflected that the mean temperature increased at an annual rate of 0.034 °C for the selected time period with a probable change point detected in the year 1996. On the seasonal scale, all the four seasons showed increasing trends for their respective average temperatures. Among the four seasons, highest increase in the temperature was reported by spring season which was subsequently followed by winter and autumn seasons. The least increase was reflected by summer season for which the variable increased at 0.20 °C/decade. The months of March and August were significant contributors to the warming that happened in Kazakhstan during the studied time period of 48 years. © 2021, King Abdulaziz University and Springer Nature Switzerland AG.},
	author_keywords = {Kazakhstan; M–K statistical test; Sen’s slope; Temperature trends},
	keywords = {Kazakhstan; air temperature; annual variation; GIS; regression analysis; seasonal variation; trend analysis},
	type = {Article},
