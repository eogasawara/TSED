@ARTICLE{Schluter2016,
	author = {Schluter, Philip J. and Hamilton, Greg J. and Deely, Joanne M. and Ardagh, Michael W.},
	title = {Impact of integrated health system changes, accelerated due to an earthquake, on emergency department attendances and acute admissions: A Bayesian change-point analysis},
	year = {2016},
