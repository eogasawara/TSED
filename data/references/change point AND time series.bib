@ARTICLE{Dette20201168,
	author = {Dette, Holger and Kokot, Kevin and Aue, Alexander},
	title = {Functional data analysis in the banach space of continuous functions},
	year = {2020},
	journal = {Annals of Statistics},
	volume = {48},
	number = {2},
	pages = {1168 – 1192},
	doi = {10.1214/19-AOS1842},
