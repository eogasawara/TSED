@CONFERENCE{Xing2021,
	author = {Xing, Y.H.},
	title = {Bootstrap test mean change point in long memory time series},
	year = {2021},
	journal = {Journal of Physics: Conference Series},
	volume = {2026},
	number = {1},
	doi = {10.1088/1742-6596/2026/1/012042},
