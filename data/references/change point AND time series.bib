	keywords = {Commerce; Financial data processing; Financial markets; Fractals; Time series; Business analytics; Change point detection; Change-points; COVID-19 pandemic; Equity markets; Financial time series; Multifractal scaling; Multifractality; Skewed multifractality; COVID-19},
