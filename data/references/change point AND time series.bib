@CONFERENCE{Li2021,
	author = {Li, Guohao and Wang, Jiandong and Xiao, Yan and Zhang, Zhiyuan},
	title = {Variable time delay estimation between time series based on significant change points},
	year = {2021},
	journal = {2021 CAA Symposium on Fault Detection, Supervision, and Safety for Technical Processes, SAFEPROCESS 2021},
	doi = {10.1109/SAFEPROCESS52771.2021.9693544},
