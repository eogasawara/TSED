}

@ARTICLE{Jalali20212280,
	author = {Jalali, Jamshid and Ahmadi, Azadeh and Abbaspour, Karim},
	title = {Runoff responses to human activities and climate change in an arid watershed of central Iran},
	year = {2021},
	journal = {Hydrological Sciences Journal},
	volume = {66},
	number = {16},
	pages = {2280 – 2297},
	doi = {10.1080/02626667.2021.1985724},
