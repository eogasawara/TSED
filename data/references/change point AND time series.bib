}

@ARTICLE{Jiang2015227,
	author = {Jiang, Feng-qing and Jilili, Abudu-waili and Wang, Shao-ping and Hu, Ru-ji and Li, Xiao-lan},
	title = {Annual thawing and freezing indices changes in the China Tianshan Mountains},
	year = {2015},
	journal = {Regional Environmental Change},
	volume = {15},
