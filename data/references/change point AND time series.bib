@CONFERENCE{Lungu2022125,
	author = {Lungu, Valentinian and Papageorgiou, Ioannis and Kontoyiannis, Ioannis},
	title = {Bayesian Change-Point Detection via Context-Tree Weighting},
	year = {2022},
	journal = {2022 IEEE Information Theory Workshop, ITW 2022},
	pages = {125 – 130},
