@ARTICLE{Alilou2022,
	author = {Alilou, Hossein and Oldham, Carolyn and McFarlane, Don and Hipsey, Matthew R.},
	title = {A structured framework to interpret hydro-climatic and water quality trends in Mediterranean climate zones},
	year = {2022},
	journal = {Journal of Hydrology},
